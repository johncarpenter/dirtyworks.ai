{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dirtyworks-ai",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets are served first; anything unmatched falls through to the Worker, which in
  // practice means only /_actions/*. Do not set `run_worker_first`.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // Cloudflare Email Service, transactional only.
  //
  // DO NOT add "remote": true. With remote bindings a locally-run Worker sends REAL email to REAL
  // recipients — including from CI. Left unset, `wrangler dev` simulates delivery and writes the
  // message to a local file, which is what lets the E2E suite exercise the accepted path.
  "send_email": [{ "name": "EMAIL" }],

  // `namespace_id` must be a stringified positive integer. `simple` is the only supported type and
  // `simple.period` must be exactly 10 or 60 — no other value is accepted.
  //
  // 10/60 rather than 5/60: the key is a hashed client IP, so everyone behind one office NAT (and
  // every E2E project on one CI runner) shares a bucket. Nobody fills this form ten times a
  // minute by hand; a script does.
  "ratelimits": [
    {
      "name": "FORM_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true
  }
}
