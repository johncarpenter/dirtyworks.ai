{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "astro/client", "node"],
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "strictNullChecks": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "design-system", "mockups", "node_modules"]
}
