{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**",
              "components/evidence/**",
              "components/forms/**",
              "components/layout/**",
              "slides/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Instrument Serif|IBM Plex Mono|Material Symbols Sharp))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Instrument Serif, IBM Plex Mono, Material Symbols Sharp."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|right|decisive|key|ref|className|style|children)$/]",
        "message": "<ComparisonRow> doesn't accept that prop. Declared props: left, right, decisive."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|thesis|evidence|date|readingTime|href|style|key|ref|className|style|children)$/]",
        "message": "<ArticleRow> doesn't accept that prop. Declared props: index, title, thesis, evidence, date, readingTime, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|icon|iconAfter|disabled|fullWidth|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, icon, iconAfter, disabled, fullWidth, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|evidence|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'evidence' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseMetric'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|baseline|period|method|source|hypothesis|style|key|ref|className|style|children)$/]",
        "message": "<CaseMetric> doesn't accept that prop. Declared props: value, unit, label, baseline, period, method, source, hypothesis, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ControlRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:control|mechanism|holder|state|status|key|ref|className|style|children)$/]",
        "message": "<ControlRow> doesn't accept that prop. Declared props: control, mechanism, holder, state, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABandAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|onClick|key|ref|className|style|children)$/]",
        "message": "<CTABandAction> doesn't accept that prop. Declared props: label, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Declaration'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|descriptor|align|tone|crop|rule|size|style|key|ref|className|style|children)$/]",
        "message": "<Declaration> doesn't accept that prop. Declared props: children, label, descriptor, align, tone, crop, rule, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Declaration'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Declaration> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Declaration'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|bone|orange)$/]",
        "message": "<Declaration> tone must be one of 'ink' | 'bone' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Declaration'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|h1|h2)$/]",
        "message": "<Declaration> size must be one of 'display' | 'h1' | 'h2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagnosticForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|note|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<DiagnosticForm> doesn't accept that prop. Declared props: heading, note, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|origin|status|statusLabel|key|ref|className|style|children)$/]",
        "message": "<EvidenceItem> doesn't accept that prop. Declared props: text, origin, status, statusLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='FitField'] > JSXAttribute > JSXIdentifier[name!=/^(?:segment|label|summary|included|excluded|style|key|ref|className|style|children)$/]",
        "message": "<FitField> doesn't accept that prop. Declared props: segment, label, summary, included, excluded, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OwnerRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:item|owner|checked|status|statusLabel|index|style|key|ref|className|style|children)$/]",
        "message": "<OwnerRow> doesn't accept that prop. Declared props: item, owner, checked, status, statusLabel, index, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProofLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|value|status|size|style|key|ref|className|style|children)$/]",
        "message": "<ProofLabel> doesn't accept that prop. Declared props: children, value, status, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProofLabel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<ProofLabel> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|context|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, attribution, context, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|bone)$/]",
        "message": "<PullQuote> tone must be one of 'ink' | 'bone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<PullQuote> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Redaction'] > JSXAttribute > JSXIdentifier[name!=/^(?:covered|revealed|open|onToggle|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Redaction> doesn't accept that prop. Declared props: covered, revealed, open, onToggle, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Redaction'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Redaction> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Redaction'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|bone)$/]",
        "message": "<Redaction> tone must be one of 'ink' | 'bone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<SiteNavItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|showDot|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tone, showDot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|bone|orange)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'bone' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkOrderStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|detail|duration|annotation|marks|key|ref|className|style|children)$/]",
        "message": "<WorkOrderStep> doesn't accept that prop. Declared props: name, detail, duration, annotation, marks."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
