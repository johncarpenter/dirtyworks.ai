---
/* The three-party responsibility list for the workspace pilot: your team, your business,
   Dirtyworks.ai. Shared by home §03 and /workspace §05 so the two pages cannot drift.

   Every party is named in text; the colour per party is reinforcement, never the signal
   (constitution Principle IV). The Dirtyworks.ai row shifts 16px and indents a further 24px on a
   raised field with an orange edge — that is the caller's grid violation to budget for. */
import { RESPONSIBILITY_ROWS } from '../../copy/pilot';

interface Props {
  title?: string;
  tone?: 'light' | 'dark';
}

const { title, tone = 'dark' } = Astro.props;
const toneOf = (party: string) =>
  party === 'Dirtyworks.ai' ? 'dirtyworks' : party === 'Your business' ? 'business' : 'team';
---

<div class:list={['roles', tone === 'light' && 'roles--light']}>
  {title ? <p class="roles__title">{title}</p> : null}
  <ul class="roles__list">
    {
      RESPONSIBILITY_ROWS.map((row) => (
        <li class:list={['roles__row', `roles__row--${toneOf(row.party)}`]}>
          <p class="roles__party">{row.party}</p>
          <p class="roles__body">{row.body}</p>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .roles__title {
    margin: 0;
    padding-bottom: 10px;
    font-family: var(--font-mono);
    font-size: var(--type-label-sm);
    font-weight: var(--weight-label);
    letter-spacing: var(--track-label-wide);
    text-transform: uppercase;
    color: var(--steel-2);
    border-bottom: 1.5px solid var(--ink-3);
  }

  .roles__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roles__row {
    padding: 22px 0;
    border-bottom: 1px solid var(--ink-3);
  }

  .roles__row--dirtyworks {
    margin-left: 16px;
    padding: 22px 0 22px 24px;
    border-left: 3px solid var(--signal-orange);
    background: var(--ink-2);
  }

  .roles__party {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: var(--weight-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .roles__row--team .roles__party {
    color: var(--blueprint-light);
  }

  .roles__row--business .roles__party {
    color: var(--verified-acid);
  }

  .roles__row--dirtyworks .roles__party {
    color: var(--signal-orange);
  }

  .roles__body {
    margin: 0;
    font-size: 17px;
    line-height: 1.48;
  }

  /* On a light ground the party colours have to hold AA against bone. */
  .roles--light .roles__title {
    color: var(--steel);
    border-bottom-color: var(--ink);
  }

  .roles--light .roles__row {
    border-bottom-color: var(--rule);
  }

  .roles--light .roles__row--dirtyworks {
    background: var(--bone-2);
  }

  .roles--light .roles__row--team .roles__party {
    color: var(--blueprint-press);
  }

  .roles--light .roles__row--business .roles__party,
  .roles--light .roles__row--dirtyworks .roles__party {
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .roles__row--dirtyworks {
      margin-left: 8px;
      padding-left: 12px;
    }
  }
</style>
