---
/* Composite 10: the hard conversion block that closes every page. */
import Band from '../layout/Band.astro';
import Folio from '../ui/Folio.astro';
import Button from '../ui/Button.astro';

interface Action {
  label: string;
  href: string;
}

interface Props {
  folio: string;
  heading: string;
  support?: string;
  primary?: Action;
  secondary?: Action;
}

const { folio, heading, support, primary, secondary } = Astro.props;
---

<Band ground="ink" class="cta-band">
  <Folio text={folio} tone="dark" />
  <h2 class="cta-band__heading">{heading}</h2>
  {support ? <p class="cta-band__support">{support}</p> : null}
  {
    primary || secondary ? (
      <div class="cta-band__actions">
        {primary ? <Button href={primary.href} size="lg">{primary.label}</Button> : null}
        {
          secondary ? (
            <Button href={secondary.href} size="lg" variant="evidence">
              {secondary.label}
            </Button>
          ) : null
        }
      </div>
    ) : null
  }
  <slot />
</Band>

<style>
  .cta-band__heading {
    font-weight: 900;
    font-size: clamp(34px, 4.6vw, 84px);
    line-height: 0.86;
    letter-spacing: -0.035em;
    max-width: 26ch;
  }

  .cta-band__support {
    margin: 32px 0 0;
    font-size: 18px;
    line-height: 1.52;
    max-width: 58ch;
  }

  .cta-band__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 44px;
  }
</style>
