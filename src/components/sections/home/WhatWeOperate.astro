---
/* Home §03. Eight register rows: mono orange label, public copy, typical records. The alternating
   24px offset belongs to the register pattern, not to the page's violation budget
   (research.md D-07 #4). */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import Declaration from '../../patterns/Declaration.astro';
import RegisterRow from '../../patterns/RegisterRow.astro';
import { OPERATE, OPERATE_ROWS } from '../../../content/pages/home';
---

<Band ground="bone" labelledBy="operate-heading">
  <Folio text={OPERATE.folio} />

  <div class="operate__head">
    <Declaration
      id="operate-heading"
      size="clamp(32px,4vw,70px)"
      leading="0.88"
      tracking="-0.035em"
      weight={900}
    >
      {OPERATE.heading}
    </Declaration>
    <p class="operate__intro">{OPERATE.intro}</p>
  </div>

  <div class="operate__register">
    {
      OPERATE_ROWS.map((row, index) => (
        <RegisterRow
          label={row.label}
          detail={row.records}
          offset={index % 2 === 1}
          last={index === OPERATE_ROWS.length - 1}
        >
          <p>{row.body}</p>
        </RegisterRow>
      ))
    }
  </div>

  <p class="operate__closing">{OPERATE.closing}</p>
</Band>

<style>
  .operate__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
    margin-bottom: 64px;
  }

  .operate__head > * {
    min-width: 0;
  }

  .operate__intro {
    margin: 0;
    font-size: 18px;
    line-height: 1.52;
    max-width: 56ch;
  }

  .operate__register {
    border-top: 1.5px solid var(--ink);
  }

  .operate__closing {
    margin: 44px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(24px, 2.4vw, 40px);
    line-height: 1.12;
    max-width: 34ch;
  }

  @media (max-width: 900px) {
    .operate__head {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 48px;
    }
  }
</style>
