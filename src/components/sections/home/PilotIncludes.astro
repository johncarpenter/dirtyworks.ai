---
/* Home §04. Four stages on the work-order spine: scope, configure, use and support, review. The
   left column sticks while the stages scroll past it. Nothing here names a duration, a cohort
   size, a launch time or a fee; the deliverables live on /workspace#pilot-scope. */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import Button from '../../ui/Button.astro';
import Declaration from '../../patterns/Declaration.astro';
import WorkOrder from '../../patterns/WorkOrder.astro';
import { PILOT_INCLUDES, PILOT_STAGES } from '../../../copy/pilot';

const { folio, heading, body, primary, secondary } = PILOT_INCLUDES;
---

<Band ground="bone" labelledBy="pilot-includes-heading">
  <Folio text={folio} />

  <div class="includes__grid">
    <div class="includes__sticky">
      <Declaration
        id="pilot-includes-heading"
        size="clamp(34px,4.2vw,74px)"
        leading="0.86"
        tracking="-0.035em"
        weight={900}
      >
        {heading}
      </Declaration>
      <p class="includes__text">{body}</p>
      <div class="includes__actions">
        <Button href={primary.href} variant="secondary">{primary.label}</Button>
        <Button href={secondary.href} variant="ghost">{secondary.label}</Button>
      </div>
    </div>

    <WorkOrder steps={PILOT_STAGES} />
  </div>
</Band>

<style>
  .includes__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .includes__grid > * {
    min-width: 0;
  }

  .includes__sticky {
    position: sticky;
    top: 108px;
  }

  .includes__text {
    margin: 26px 0 0;
    font-size: 18px;
    line-height: 1.52;
    max-width: 44ch;
  }

  .includes__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  @media (max-width: 900px) {
    .includes__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .includes__sticky {
      position: static;
    }
  }
</style>
