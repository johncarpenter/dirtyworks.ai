---
/* Home §04. Seven menu rows. Candidate product names are mono TEXT and never a logo cloud, and the
   VERIFY AT QUOTE stamp opens the disclaimer that closes the menu. */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import Button from '../../ui/Button.astro';
import ClaimStamp from '../../ui/ClaimStamp.astro';
import Declaration from '../../patterns/Declaration.astro';
import { CATALOGUE, MENU_ENTRIES } from '../../../content/pages/home';
---

<Band ground="bone-2" labelledBy="catalogue-heading">
  <Folio text={CATALOGUE.folio} />

  <div class="catalogue__grid">
    <div>
      <Declaration
        id="catalogue-heading"
        size="clamp(30px,3.2vw,56px)"
        leading="0.92"
        tracking="-0.03em"
        weight={800}
      >
        {CATALOGUE.heading}
      </Declaration>

      {CATALOGUE.paragraphs.map((text) => <p class="catalogue__text">{text}</p>)}

      <div class="catalogue__actions">
        <Button href={CATALOGUE.primary.href}>{CATALOGUE.primary.label}</Button>
        <Button href={CATALOGUE.secondary.href} variant="ghost">{CATALOGUE.secondary.label}</Button>
      </div>
    </div>

    <div class="catalogue__menu">
      <ul class="catalogue__rows">
        {
          MENU_ENTRIES.map((entry, index) => (
            <li
              class:list={[
                'catalogue__row',
                index === MENU_ENTRIES.length - 1 && 'catalogue__row--last',
              ]}
            >
              <span class="catalogue__word">{entry.word}</span>
              <span class="catalogue__job">
                <span class="catalogue__job-name">{entry.job}</span>
                <span class="catalogue__candidates">{entry.candidates}</span>
              </span>
              <span class="catalogue__emphasis">{entry.emphasis}</span>
            </li>
          ))
        }
      </ul>

      <p class="catalogue__disclaimer">
        <ClaimStamp state="VERIFY AT QUOTE" label={CATALOGUE.disclaimerStamp} />{CATALOGUE.disclaimer}
      </p>
    </div>
  </div>
</Band>

<style>
  .catalogue__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .catalogue__grid > * {
    min-width: 0;
  }

  .catalogue__text {
    margin: 26px 0 0;
    font-size: 18px;
    line-height: 1.52;
  }

  .catalogue__text + .catalogue__text {
    margin-top: 20px;
  }

  .catalogue__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 36px;
  }

  .catalogue__menu {
    border-top: 1.5px solid var(--ink);
  }

  .catalogue__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .catalogue__row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(12px, 2vw, 32px);
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }

  .catalogue__row > * {
    min-width: 0;
  }

  .catalogue__row--last {
    border-bottom: 1.5px solid var(--ink);
  }

  .catalogue__word {
    font-family: var(--font-display);
    font-weight: var(--weight-display-max);
    font-size: 26px;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .catalogue__job-name {
    display: block;
    font-size: 17px;
    font-weight: var(--weight-strong);
    line-height: 1.3;
  }

  /* Candidate products: text, in mono, never a mark or a logo. */
  .catalogue__candidates {
    display: block;
    margin-top: 7px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
    line-height: 1.7;
  }

  .catalogue__emphasis {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    line-height: 1.25;
    color: var(--blueprint-press);
  }

  .catalogue__disclaimer {
    margin: 20px 0 0;
    font-family: var(--font-mono);
    font-size: var(--type-label-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
    line-height: 1.8;
    max-width: 70ch;
  }

  @media (max-width: 1000px) {
    .catalogue__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .catalogue__row {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 12px;
    }

    .catalogue__emphasis {
      grid-column: 2;
    }
  }
</style>
