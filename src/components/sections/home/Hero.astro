---
/* Home §01. The declaration, the offer, the two actions, and the illustrative AI portfolio
   register. The heading's emphasised word is pulled -0.06em off the left edge as an inline block:
   that pull is the first of the page's two deliberate grid violations. */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import Button from '../../ui/Button.astro';
import ClaimStamp from '../../ui/ClaimStamp.astro';
import ProofLabel from '../../ui/ProofLabel.astro';
import Declaration from '../../patterns/Declaration.astro';
import { HERO, PORTFOLIO_ROWS } from '../../../copy/pages/home';
---

<Band ground="bone" variant="hero" labelledBy="hero-heading" class="hero">
  <div class="hero__grid">
    <div class="hero__lede">
      <Folio text={HERO.folio} />

      <Declaration
        as="h1"
        id="hero-heading"
        size="clamp(52px,7.6vw,134px)"
        leading="0.84"
        tracking="-0.035em"
        weight={900}
      >
        {HERO.headingLine1}<br />{HERO.headingLine2Before}<span class="hero__pull"
          >{HERO.headingPull}</span
        >{HERO.headingLine2After}
      </Declaration>

      <p class="hero__support">{HERO.support}</p>

      <div class="hero__actions">
        <Button href={HERO.primary.href} size="lg">{HERO.primary.label}</Button>
        <Button href={HERO.secondary.href} size="lg" variant="secondary">
          {HERO.secondary.label}
        </Button>
      </div>
    </div>

    <div class="hero__register">
      <div class="hero__register-head">
        <span>{HERO.registerTitle}</span>
        <ClaimStamp state="ILLUSTRATIVE" label={HERO.registerStamp} />
      </div>

      <ul class="hero__rows">
        {
          PORTFOLIO_ROWS.map((row) => (
            <li class:list={['hero__row', row.flagged && 'hero__row--flagged']}>
              <span class="hero__cell hero__cell--product">
                <span class="hero__product">{row.name}</span>
                <span class="hero__meta">{row.meta}</span>
              </span>
              <span class="hero__cell hero__cell--status">
                <ProofLabel status={row.statusKind}>{row.status}</ProofLabel>
              </span>
            </li>
          ))
        }
      </ul>

      <p class="hero__caption">{HERO.registerCaption}</p>
    </div>
  </div>
</Band>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(300px, 1fr);
    gap: 64px;
    align-items: end;
  }

  .hero__grid > * {
    min-width: 0;
  }

  /* Violation 1 of 2: the display word breaks the left edge. */
  .hero__pull {
    display: inline-block;
    margin-left: -0.06em;
    color: var(--orange-press);
  }

  .hero__support {
    margin: 34px 0 0;
    font-size: clamp(19px, 1.5vw, 28px);
    line-height: 1.34;
    max-width: 52ch;
  }

  .hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 44px;
  }

  .hero__register {
    margin-bottom: 6px;
  }

  .hero__register-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: var(--type-label-sm);
    font-weight: var(--weight-label);
    letter-spacing: var(--track-label-wide);
    text-transform: uppercase;
    color: var(--steel);
    border-bottom: 1.5px solid var(--ink);
    padding-bottom: 8px;
  }

  /* The 1px gap over a rule-coloured ground IS the hairline: no per-cell borders. */
  .hero__rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-top: 0;
  }

  .hero__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1px;
  }

  .hero__row > * {
    min-width: 0;
  }

  .hero__cell {
    background: var(--bone-3);
  }

  .hero__cell--product {
    display: block;
    padding: 12px 12px 10px;
  }

  .hero__cell--status {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 12px;
  }

  .hero__row--flagged .hero__cell--product {
    border-left: 3px solid var(--signal-orange);
  }

  .hero__product {
    display: block;
    font-size: 16px;
    font-weight: var(--weight-strong);
  }

  .hero__meta {
    display: block;
    margin-top: 5px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--steel);
  }

  .hero__caption {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel-2);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    /* Declaration, support, actions, then the register. */
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
  }

  @media (max-width: 480px) {
    .hero__row {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__cell--status {
      justify-content: flex-start;
      padding: 0 12px 12px;
    }
  }
</style>
