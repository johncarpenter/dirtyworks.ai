---
/* Catalogue §03. Seven jobs, expanded. Each row states the operating tier, the job, the
   prerequisites, the candidate products as plain text, the listing state, the purchase route, and
   the operating work the service adds on top of the licence.

   There is no buy button and no per-seat figure here, and there must never be one: the page sells
   an operating model, and the software invoice is a separate question answered at quote. The
   disclaimer carries the VERIFY AT QUOTE stamp registered in src/copy/claim-artefacts.ts. */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import Button from '../../ui/Button.astro';
import ProofLabel from '../../ui/ProofLabel.astro';
import ClaimStamp from '../../ui/ClaimStamp.astro';
import { PRODUCT_MENU } from '../../../copy/pages/catalogue';

const { folio, categories, primary, secondary, disclaimer } = PRODUCT_MENU;

/* Grouped by operating tier rather than run as seven undifferentiated rows.
   The tier was already on every row as a small mono label, repeated four times for Operate; it is
   a real distinction — how much of the work the service takes on — and stating it once at the head
   of a block turns seven things to scan into three.

   Derived from the copy, never a second list: the order is the order the tiers first appear in
   PRODUCT_MENU.categories, and the heading is the row's own `tier` string verbatim. Add a category
   in a new tier and its block appears; nothing here needs editing. */
const groups: { tier: string; rows: typeof categories }[] = [];
for (const category of categories) {
  const group = groups.find((candidate) => candidate.tier === category.tier);
  if (group) group.rows.push(category);
  else groups.push({ tier: category.tier, rows: [category] });
}

/* The offset stripe alternates across the whole menu, not within each block: restarting it per
   group would put two grounds of the same shade back to back at a boundary. */
let stripe = -1;
---

<Band ground="bone">
  <Folio text={folio} />

  <div class="menu">
    {
      groups.map((group) => (
        <section class="tier" aria-label={group.tier}>
          <p class="tier__head">{group.tier}</p>

          {group.rows.map((category, index) => {
            stripe += 1;
            return (
              <div
                class:list={[
                  'category',
                  stripe % 2 === 1 && 'category--offset',
                  index === group.rows.length - 1 && 'category--last',
                ]}
              >
                <div>
                  <p class="category__word">{category.word}</p>
                </div>

                <div>
                  <p class="category__job">{category.job}</p>
                  <div class="category__expand" data-category-expand>
                    <p class="category__detail">{category.detail}</p>
                    <p class="category__candidates">{category.candidates}</p>
                  </div>
                </div>

                <div class="category__terms">
                  <ProofLabel status={category.status}>{category.state}</ProofLabel>
                  <p class="category__route">{category.route}</p>
                  <p class="category__emphasis">{category.emphasis}</p>
                </div>
              </div>
            );
          })}
        </section>
      ))
    }
  </div>

  <button class="menu__toggle" type="button" data-menu-toggle hidden aria-expanded="true">
    Show prerequisites and products
  </button>

  <div class="menu__actions">
    <Button href={primary.href}>{primary.label}</Button>
    <Button href={secondary.href} variant="ghost">{secondary.label}</Button>
    <p class="menu__note">
      <ClaimStamp state="VERIFY AT QUOTE" /> {disclaimer}
    </p>
  </div>
</Band>

<script is:inline>
  (() => {
    const narrow = window.matchMedia('(max-width: 900px)');
    const toggle = document.querySelector('[data-menu-toggle]');
    const panels = document.querySelectorAll('[data-category-expand]');
    if (!toggle || panels.length === 0) return;

    let expanded = !narrow.matches;

    const render = () => {
      toggle.hidden = !narrow.matches;
      toggle.setAttribute('aria-expanded', String(expanded));
      toggle.textContent = expanded
        ? 'Hide prerequisites and products'
        : 'Show prerequisites and products';
      for (const panel of panels) {
        panel.hidden = narrow.matches && !expanded;
      }
    };

    toggle.addEventListener('click', () => {
      expanded = !expanded;
      render();
    });

    narrow.addEventListener('change', () => {
      expanded = !narrow.matches;
      render();
    });

    render();
  })();
</script>

<style>
  .category {
    display: grid;
    grid-template-columns: minmax(120px, 0.5fr) minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(16px, 3vw, 40px);
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }

  .category > * {
    min-width: 0;
  }

  .category--offset {
    padding: 28px 0 28px 24px;
    background: var(--bone-2);
  }

  .category--last {
    border-bottom: 1.5px solid var(--ink);
  }

  .category__word {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 34px;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  /* The menu carries no top rule of its own any more: each block head draws one, and a rule at the
     top of the menu would double up above the first block.

     The block head. It carries the tier once, where the row label used to carry it seven times.
     Ink rule above and mono at label scale: the same grammar as every other register head on the
     site, so a new level of structure arrives without a new visual device. */
  .tier__head {
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 1.5px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: var(--weight-label);
    letter-spacing: var(--track-label-wide);
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Space between blocks, and none above the first — the menu's own rule already sits there. */
  .tier + .tier {
    margin-top: clamp(36px, 4vw, 60px);
  }

  .category__job {
    margin: 0;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.28;
  }

  .category__detail {
    margin: 10px 0 0;
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .category__candidates {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
    line-height: 1.7;
    overflow-wrap: break-word;
  }

  .category__terms {
    display: grid;
    gap: 8px;
    justify-items: start;
  }

  .category__terms > * {
    min-width: 0;
  }

  .category__route {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
    line-height: 1.7;
  }

  .category__emphasis {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    line-height: 1.25;
    color: var(--blueprint-press);
  }

  .menu__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 36px;
    align-items: center;
  }

  .menu__note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel-2);
    max-width: 34ch;
    line-height: 1.7;
  }

  .menu__toggle {
    margin-top: 20px;
    background: transparent;
    color: var(--ink);
    border: 1.5px solid var(--ink);
    border-radius: 0;
    padding: 12px 16px;
    min-height: var(--target-min);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--weight-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .menu__toggle:hover {
    background: var(--bone-3);
  }

  @media (max-width: 900px) {
    /* Categories stack rather than scroll sideways; the candidate list wraps. */
    .category {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .category--offset {
      padding-left: 12px;
    }
  }
</style>
