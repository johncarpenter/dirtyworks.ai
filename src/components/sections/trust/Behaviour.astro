---
/* /trust §02 — limitations first. This section renders BEFORE the control register: the page states
   what it will not do before it states what it controls (mockups/README.md, Trust section order).
   Numbered ink-2 panels plus the serif countervoice. */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import { TRUST_LIMITATIONS } from '../../../copy/pages/trust';

const { folio, heading, pullQuote, items } = TRUST_LIMITATIONS;
---

<Band ground="ink" labelledBy="limitations-heading" class="limitations">
  <Folio text={folio} tone="dark" />

  <div class="limitations__split">
    <div class="limitations__voice">
      <h2 id="limitations-heading">{heading}</h2>
      <p class="limitations__quote">{pullQuote}</p>
    </div>

    <ol class="limitations__list">
      {
        items.map((item, index) => (
          <li class="limitations__item">
            <span class="limitations__index">{String(index + 1).padStart(2, '0')}</span>
            <span class="limitations__text">{item}</span>
          </li>
        ))
      }
    </ol>
  </div>
</Band>

<style>
  .limitations__split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .limitations__split > * {
    min-width: 0;
  }

  .limitations h2 {
    font-weight: 900;
    font-size: clamp(34px, 4.4vw, 80px);
    line-height: 0.86;
    letter-spacing: -0.035em;
  }

  .limitations__quote {
    margin: 32px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(26px, 2.6vw, 42px);
    line-height: 1.12;
    max-width: 22ch;
    border-left: 3px solid var(--signal-orange);
    padding-left: 24px;
  }

  /* One hairline grid: the 1px gap is the rule, the panels are the cells. */
  .limitations__list {
    display: grid;
    gap: 1px;
    background: var(--ink-3);
    border: 1px solid var(--ink-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .limitations__item {
    background: var(--ink-2);
    padding: 16px 20px;
    display: flex;
    gap: 16px;
    align-items: baseline;
  }

  .limitations__index {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--signal-orange);
  }

  .limitations__text {
    font-size: 17.5px;
    line-height: 1.4;
    min-width: 0;
  }

  @media (max-width: 900px) {
    .limitations__split {
      grid-template-columns: 1fr;
    }
  }
</style>
