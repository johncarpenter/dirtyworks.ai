---
/* The editorial index: three notes in preparation, then the rest of the queue.

   Not blog cards. A row states its argument, so the thesis can be read without the note existing
   yet. Queued items carry a number and a title and nothing else — the QueuedNote type has no href,
   no date and no reading time, so there is no field in which to fabricate one. */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import ProofLabel from '../../ui/ProofLabel.astro';
import {
  IN_PREPARATION,
  IN_PREPARATION_FOLIO,
  QUEUE,
  QUEUE_FOLIO,
  QUEUE_NOTE,
} from '../../../content/pages/notes';

/* The prototype splits the queue into two hairline columns that read downwards, 04–08 then 09–12,
   rather than letting grid auto-flow scatter the order across a row. */
const columns = [QUEUE.slice(0, 5), QUEUE.slice(5)];
---

<Band ground="bone-2" labelledBy="in-preparation-folio">
  <Folio id="in-preparation-folio" text={IN_PREPARATION_FOLIO} />
  <ol class="prep">
    {
      IN_PREPARATION.map((note, i) => (
        <li
          class:list={[
            'prep__row',
            i % 2 === 1 && 'prep__row--offset',
            i === IN_PREPARATION.length - 1 && 'prep__row--last',
          ]}
        >
          <span class="prep__index">{note.index}</span>
          <h2 class="prep__title">{note.title}</h2>
          <p class="prep__thesis">{note.thesis}</p>
          <div class="prep__state">
            <ProofLabel status="source" size="sm">
              {note.series}
            </ProofLabel>
            <span class="prep__pending">{note.state}</span>
          </div>
        </li>
      ))
    }
  </ol>
</Band>

<Band ground="bone" labelledBy="queue-folio">
  <Folio id="queue-folio" text={QUEUE_FOLIO} />
  <div class="queue">
    {
      columns.map((column, columnIndex) => (
        <div class="queue__column">
          <ul class="queue__list">
            {column.map((item, i) => (
              <li class:list={['queue__row', i === column.length - 1 && 'queue__row--last']}>
                <span class="queue__index">{item.index}</span>
                <span class="queue__title">{item.title}</span>
              </li>
            ))}
          </ul>
          {columnIndex === columns.length - 1 ? <p class="queue__note">{QUEUE_NOTE}</p> : null}
        </div>
      ))
    }
  </div>
</Band>

<style>
  .prep {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }

  .prep__row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1.5fr) minmax(0, 1fr) minmax(120px, auto);
    gap: clamp(16px, 3vw, 40px);
    padding: 30px 0;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }

  .prep__row > * {
    min-width: 0;
  }

  /* The alternating row takes the 24px offset and a lifted ground: the deliberate irregularity
     the register pattern carries on every page. */
  .prep__row--offset {
    padding-left: 24px;
    background: var(--bone-3);
  }

  .prep__row--last {
    border-bottom: 1.5px solid var(--ink);
  }

  .prep__index {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--ink);
  }

  .prep__title {
    font-weight: var(--weight-display);
    font-size: clamp(22px, 2.4vw, 38px);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .prep__thesis {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    line-height: 1.25;
    color: var(--ink-3);
  }

  .prep__state {
    display: grid;
    gap: 8px;
    justify-items: start;
  }

  .prep__pending {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel-2);
  }

  .queue {
    display: grid;
    /* min() keeps the 320px track from outgrowing a 320px viewport. */
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 clamp(32px, 5vw, 64px);
  }

  .queue > * {
    min-width: 0;
  }

  .queue__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }

  .queue__row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }

  .queue__row > * {
    min-width: 0;
  }

  .queue__row--last {
    border-bottom: 1.5px solid var(--ink);
  }

  .queue__index {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--steel-2);
  }

  .queue__title {
    font-size: 18px;
    font-weight: var(--weight-label);
    line-height: 1.35;
  }

  .queue__note {
    margin: 24px 0 0;
    font-family: var(--font-mono);
    font-size: var(--type-label-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .prep__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .prep__row--offset {
      padding-left: 12px;
    }
  }
</style>
