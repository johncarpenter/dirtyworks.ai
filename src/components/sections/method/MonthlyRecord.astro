---
/* /method §04 — the monthly operating record. Registered as `method-monthly-record` in
   src/copy/claim-artefacts.ts: this is a specimen sheet, so it renders its ILLUSTRATIVE stamp
   and the release gate fails without it. The closing field is the only one that commits to future
   work, and it carries the orange edge. */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import ClaimStamp from '../../ui/ClaimStamp.astro';
import { METHOD_RECORD } from '../../../copy/pages/method';

const { folio, heading, body, sheetTitle, fields } = METHOD_RECORD;
---

<Band ground="bone-2" labelledBy="record-heading" class="record">
  <Folio text={folio} />

  <div class="record__split">
    <div>
      <h2 id="record-heading">{heading}</h2>
      <p class="record__body">{body}</p>
    </div>

    <div class="record__sheet">
      <div class="record__head">
        <p class="record__title">{sheetTitle}</p>
        <span class="record__stamp"><ClaimStamp state="ILLUSTRATIVE" /></span>
      </div>

      <dl class="record__fields">
        {
          fields.map((field) => (
            <div class:list={['record__field', field.emphasis && 'record__field--next']}>
              <dt class="record__label">{field.label}</dt>
              <dd class="record__value">{field.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</Band>

<style>
  .record__split {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .record__split > * {
    min-width: 0;
  }

  .record h2 {
    font-weight: 800;
    font-size: clamp(28px, 3vw, 52px);
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  .record__body {
    margin: 24px 0 0;
    font-size: 18px;
    line-height: 1.52;
    max-width: 40ch;
  }

  .record__sheet {
    background: var(--bone-3);
    border: 1.5px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .record__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-bottom: 1.5px solid var(--ink);
    background: var(--bone);
  }

  .record__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: var(--weight-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* The prototype sets the sheet stamp as a filled chip rather than the bare mono mark. */
  .record__stamp :global(.claim-stamp) {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.12em;
    background: var(--signal-orange);
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 2px;
    padding: 4px 8px;
    white-space: nowrap;
  }

  /* Hairline grid. Ten fields never divide evenly into an auto-fit column count, so the rule
     cannot be the grid's ground — an unfilled cell would read as a blank field. Each field draws
     its own 1px rule instead: neighbouring rules coincide inside the 1px gap, and the outer ring
     falls outside the grid box, where `overflow: hidden` clips it against the sheet's own edge. */
  .record__fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    margin: 0;
    overflow: hidden;
  }

  .record__fields > * {
    min-width: 0;
  }

  .record__field {
    padding: 16px 20px;
    outline: 1px solid var(--rule);
  }

  /* Ten fields never divide evenly into an auto-fit grid, and the hairline ground would otherwise
     show through as two blank cells. The closing commitment closes the sheet instead. */
  .record__field--next {
    grid-column: 1 / -1;
    border-left: 3px solid var(--signal-orange);
  }

  .record__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* --steel, not --steel-2: 10px text on the bone-3 sheet needs the AA-passing muted tone. */
    color: var(--steel);
    margin-bottom: 8px;
  }

  .record__value {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .record__split {
      grid-template-columns: 1fr;
    }
  }
</style>
