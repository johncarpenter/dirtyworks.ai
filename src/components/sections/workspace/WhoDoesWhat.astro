---
/* /workspace §05, ink band. The same three rows as home §03, plus the sentence that keeps
   team-created tools honest: a supported business tool needs an agreed owner and maintenance
   scope. The Dirtyworks.ai row's offset is this page's second grid violation. */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import Declaration from '../../patterns/Declaration.astro';
import ResponsibilityRows from '../../patterns/ResponsibilityRows.astro';
import { WHO_DOES_WHAT } from '../../../copy/pages/workspace';

const { folio, heading, body, closing } = WHO_DOES_WHAT;
---

<Band ground="ink" labelledBy="who-heading">
  <Folio text={folio} tone="dark" />

  <div class="who__grid">
    <div>
      <Declaration
        id="who-heading"
        size="clamp(34px,4.2vw,76px)"
        leading="0.86"
        tracking="-0.035em"
        weight={900}
      >
        {heading}
      </Declaration>
      <p class="who__text">{body}</p>
      <p class="who__closing">{closing}</p>
    </div>

    <ResponsibilityRows title="Who does what" tone="dark" />
  </div>
</Band>

<style>
  .who__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .who__grid > * {
    min-width: 0;
  }

  .who__text {
    margin: 26px 0 0;
    font-size: 18px;
    line-height: 1.52;
    max-width: 50ch;
  }

  .who__closing {
    margin: 28px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(22px, 2.2vw, 34px);
    line-height: 1.15;
    max-width: 34ch;
    border-left: 3px solid var(--signal-orange);
    padding-left: 24px;
  }

  @media (max-width: 900px) {
    .who__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
