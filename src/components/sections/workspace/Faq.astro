---
/* /workspace §08. Six questions as a plain hairline list: question as an h3, answer as a
   paragraph, no disclosure widget. Everything is readable without JavaScript and by a screen
   reader in document order. */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import Declaration from '../../patterns/Declaration.astro';
import { FAQ } from '../../../copy/pages/workspace';

const { folio, heading, items } = FAQ;
---

<Band ground="bone" labelledBy="faq-heading">
  <Folio text={folio} />

  <div class="faq__grid">
    <Declaration
      id="faq-heading"
      size="clamp(30px,3.4vw,60px)"
      leading="0.92"
      tracking="-0.03em"
      weight={800}
    >
      {heading}
    </Declaration>

    <ol class="faq__list">
      {
        items.map((item, index) => (
          <li class:list={['faq__item', index === items.length - 1 && 'faq__item--last']}>
            <span class="faq__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="faq__body">
              <h3 class="faq__question">{item.question}</h3>
              <p class="faq__answer">{item.answer}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Band>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .faq__grid > * {
    min-width: 0;
  }

  .faq__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }

  .faq__item {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }

  .faq__item > * {
    min-width: 0;
  }

  .faq__item:nth-child(even) {
    background: var(--bone-2);
    padding-left: 24px;
  }

  .faq__item--last {
    border-bottom: 1.5px solid var(--ink);
  }

  .faq__index {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--steel);
    padding-top: 6px;
  }

  .faq__question {
    margin: 0;
    font-weight: var(--weight-display);
    font-size: clamp(20px, 1.9vw, 30px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .faq__answer {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.52;
    max-width: 62ch;
  }

  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .faq__item {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 10px;
    }

    .faq__item:nth-child(even) {
      padding-left: 12px;
    }
  }
</style>
