---
/* Services §02 — the two ways an engagement starts. Distinct from EngagementPath (§04): this
   section is about what the customer brings on day one, that one is about how the work runs over
   time. A visitor should be able to point at one of these two panels before reading anything else.

   The quoted situations are set in the serif italic the site reserves for a countervoice, because
   that is what they are — the customer's sentence, not ours. */
import Band from '../../layout/Band.astro';
import Folio from '../../ui/Folio.astro';
import { SERVICE_MODELS } from '../../../copy/pages/services';

const { folio, heading, models, voicesCaption, closing } = SERVICE_MODELS;
const headingId = 'service-models-heading';
---

<Band ground="bone-2" labelledBy={headingId}>
  <Folio text={folio} />
  <h2 class="models__heading" id={headingId}>{heading}</h2>

  <div class="models__grid">
    {
      models.map((model) => (
        <div class="model">
          <p class="model__label">{model.label}</p>
          <p class="model__brings">{model.brings}</p>
          <p class="model__supplies">{model.supplies}</p>

          <p class="model__caption">{voicesCaption}</p>
          <ul class="model__voices">
            {model.voices.map((voice) => (
              <li class="model__voice">{voice}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="models__foot">
    <p class="models__closing">{closing}</p>
  </div>
</Band>

<style>
  .models__heading {
    margin: 0 0 48px;
    font-weight: 900;
    font-size: clamp(30px, 3.6vw, 64px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    max-width: 24ch;
  }

  .models__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(32px, 4vw, 64px);
    border-top: 1.5px solid var(--ink);
    padding-top: 32px;
  }

  .models__grid > * {
    min-width: 0;
  }

  .model__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: var(--weight-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--orange-press);
  }

  /* The one line a visitor should be able to point at. */
  .model__brings {
    margin: 16px 0 0;
    font-weight: 900;
    font-size: clamp(28px, 2.8vw, 46px);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .model__supplies {
    margin: 20px 0 0;
    font-size: 17px;
    line-height: 1.55;
    max-width: 46ch;
  }

  .model__caption {
    margin: 32px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--weight-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .model__voices {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .model__voice {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(19px, 1.6vw, 24px);
    line-height: 1.24;
    border-left: 3px solid var(--signal-orange);
    padding-left: 18px;
  }

  /* The rule spans the full band; only the text is held to a readable measure. Putting both on
     one element left a half-width hairline hanging under the first column. */
  .models__foot {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .models__closing {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    max-width: 64ch;
  }
</style>
