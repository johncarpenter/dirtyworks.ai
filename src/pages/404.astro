---
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/layout/Band.astro';
import Folio from '../components/ui/Folio.astro';
import Button from '../components/ui/Button.astro';
import { headerNav } from '../content/navigation';
---

<BaseLayout route="home" title="Page not found | Dirtyworks.ai" description={null}>
  <Band ground="bone" variant="hero">
    <Folio text="404 / No such record" />
    <h1 class="notfound__heading">That page is not on the register.</h1>
    <p class="notfound__support">
      The address does not match anything we operate. Everything the site publishes is one link
      away below.
    </p>
    <ul class="notfound__list">
      {headerNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <div class="notfound__actions">
      <Button href="/" variant="secondary" size="lg">Back to the start</Button>
      <Button href="/start" size="lg">Map your AI stack</Button>
    </div>
  </Band>
</BaseLayout>

<style>
  .notfound__heading {
    font-weight: 900;
    font-size: clamp(40px, 6vw, 104px);
    line-height: 0.86;
    letter-spacing: -0.035em;
    max-width: 22ch;
  }

  .notfound__support {
    margin: 32px 0 0;
    font-size: clamp(19px, 1.5vw, 26px);
    line-height: 1.34;
    max-width: 48ch;
  }

  .notfound__list {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .notfound__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 44px;
  }
</style>
