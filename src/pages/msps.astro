---
/* /msps — the partner page. Five bands and the conversion block, in prototype order:
   hero, what the practice adds, three models, responsibility seam, one-customer pilot, CTA.

   The header action on this route is the partner action ("Design a partner pilot"); it comes from
   routes.ts via BaseLayout and is never hand-rolled here. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Folio from '../components/ui/Folio.astro';
import Button from '../components/ui/Button.astro';
import PhotoHero from '../components/patterns/PhotoHero.astro';
import CTABand from '../components/patterns/CTABand.astro';
import PracticeAdds from '../components/sections/msps/PracticeAdds.astro';
import Models from '../components/sections/msps/Models.astro';
import SeamMatrix from '../components/sections/msps/SeamMatrix.astro';
import Pilot from '../components/sections/msps/Pilot.astro';
import { CTA, HERO } from '../copy/pages/msps';
import { hrefFor } from '../copy/routes';
import { ENERGY_SERVICES } from '../copy/photography';
import energyServices from '../assets/photography/energy-services-project-office-v1.png';
---

<BaseLayout route="msps">
  {/* The energy-services project office. The placement plan lists it for "energy-services fit
      section, industry landing page, or integration/knowledge section"; this is the closest thing
      the site has to an industry landing page, and the picture is two organisations comparing
      requirements and closeout documents across a table — which is what a partner seam is.
      The capsule sits LEFT because the people are left/centre... so it goes right instead. */}
  <PhotoHero
    image={energyServices}
    alt={ENERGY_SERVICES.alt}
    focus={ENERGY_SERVICES.focus}
    capsuleSide="right"
    labelledBy="msps-hero-heading"
  >
    <div class="hero__lede">
      <Folio text={HERO.folio} />

      <h1 class="hero__heading" id="msps-hero-heading">
        {HERO.lineOne}<br /><span class="hero__pull"
          >{HERO.lineTwoBefore}<span class="hero__accent">{HERO.lineTwoAccent}</span>{
            HERO.lineTwoAfter
          }</span
        >
      </h1>

      <div class="hero__foot">
        <p class="hero__lead">{HERO.lead}</p>
        <div>
          <Button href={hrefFor('start')} size="lg">{HERO.action}</Button>
        </div>
      </div>
    </div>
  </PhotoHero>

  <PracticeAdds />
  <Models />
  <SeamMatrix />
  <Pilot />

  <CTABand
    folio={CTA.folio}
    heading={CTA.heading}
    support={CTA.support}
    primary={{ label: CTA.primaryLabel, href: hrefFor('start') }}
    secondary={{ label: CTA.secondaryLabel, href: hrefFor('trust') }}
  />
</BaseLayout>

<style>
  /* clamp(38px,4.4vw,76px) is the shared capsule-hero scale — the same on /, /services, /trust and
     /msps, so the four openings read as one system. Roughly half the old display size, which is
     the trade for putting the copy in a capsule (see PhotoHero).

     The 4.4vw step is not free choice: tests/e2e/fidelity.spec.ts holds heroes to at least 60px at
     its 1440px desktop viewport, and that guard exists because two pages once shipped at 34px from
     a silent scoped-CSS failure. 4vw lands at 57.6px and trips it. Do not lower this. */
  .hero__heading {
    margin: 0;
    font-weight: var(--weight-display-max);
    font-size: clamp(38px, 4.4vw, 76px);
    line-height: 0.84;
    letter-spacing: -0.035em;
  }

  /* The build-wide optical pull: the second line hangs left of the measure so the two lines read
     as one block (research.md D-07 #4 — a device, not this page's violation). */
  .hero__pull {
    display: inline-block;
    margin-left: -0.05em;
  }

  .hero__accent {
    color: var(--orange-press);
  }

  /* One column inside the capsule: a 1.3fr/1fr split of 30em leaves the action too narrow. */
  .hero__foot {
    display: grid;
    gap: clamp(20px, 2.4vw, 32px);
    justify-items: start;
    margin-top: clamp(18px, 2vw, 28px);
  }

  .hero__foot > * {
    min-width: 0;
  }

  .hero__lead {
    margin: 0;
    font-size: clamp(16px, 1.15vw, 21px);
    line-height: 1.4;
    max-width: 46ch;
  }
</style>
