---
/* /start — the shared inquiry form. One destination for the workspace pilot, the existing-AI
   route, and the MSP route; the interest arrives in the query string and is parsed by the island
   after mount (the page is prerendered). A bare /start assumes nothing: not a failure to report,
   not a pilot. */
import '../styles/intake.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/layout/Band.astro';
import Folio from '../components/ui/Folio.astro';
import Button from '../components/ui/Button.astro';
import StartForm from '../components/islands/StartForm';
import { CONTACT_EMAIL, INTAKE_MAILTO_SUBJECT } from '../copy/site';
import { hrefFor, inquiryHref } from '../copy/routes';

const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(INTAKE_MAILTO_SUBJECT)}`;

/* No response-time commitment is stated here, because none has been agreed. */
const nextSteps = [
  'We review the work and discuss whether the service fits.',
  'If it does, we prepare a proposed scope and costs.',
  'No pilot begins from submitting this form alone.',
];
---

<BaseLayout route="start">
  <Band ground="bone" variant="hero">
    <Folio text="Start / 01 — Inquiry" />
    <h1 class="start__heading">
      Let's scope a useful place to <span class="start__emphasis">start</span>.
    </h1>
    <p class="start__support">
      Tell us about your team and the work you want to improve. We will use this to discuss fit
      and what a first scope could include.
    </p>
  </Band>

  <Band ground="bone-2" class="start__body">
    <div class="start__grid">
      <div>
        <StartForm client:load />

        <noscript>
          <div class="intake-noscript">
            <h2>Send the same details by email</h2>
            <p>
              The inquiry form needs JavaScript to validate and send. Email
              <a href={mailto}>{CONTACT_EMAIL}</a> instead and include:
            </p>
            <ul>
              <li>Name, company, and a work email we can reply to</li>
              <li>
                Your interest: a workspace pilot, managing existing AI tools, an MSP partnership,
                or not sure yet
              </li>
              <li>What you would like your team to do, build, or improve</li>
            </ul>
            <p>
              Please do not include credentials, private documents, or customer or employee
              records.
            </p>
          </div>
        </noscript>
      </div>

      <div class="start__sidebar">
        <div class="start__panel">
          <p class="start__panel-title">What happens next</p>
          <ol class="start__steps">
            {
              nextSteps.map((step, index) => (
                <li>
                  <span class="start__step-index">{String(index + 1).padStart(2, '0')}</span>
                  <span>{step}</span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="start__routes">
          <p class="start__panel-title start__panel-title--light">Prefer a specific route?</p>
          <p class="start__routes-body">
            Each link opens this form with the interest already selected. You can change it.
          </p>
          <ul class="start__route-list">
            <li><a href={inquiryHref('workspace-pilot')}>Workspace pilot</a></li>
            <li><a href={inquiryHref('existing-ai')}>Existing AI management</a></li>
            <li><a href={inquiryHref('msp-partner')}>MSP partnership</a></li>
          </ul>
        </div>

        <div class="start__partner">
          <p class="start__panel-title start__panel-title--light">Running an MSP?</p>
          <p class="start__partner-body">
            Read how referral, co-managed, and white-label pilots share the work before you write.
          </p>
          <Button href={hrefFor('msps')} variant="ghost">Read the partner models</Button>
        </div>
      </div>
    </div>
  </Band>
</BaseLayout>

<style>
  .start__heading {
    font-weight: 900;
    font-size: clamp(46px, 7vw, 126px);
    line-height: 0.86;
    letter-spacing: -0.035em;
    max-width: 24ch;
  }

  .start__emphasis {
    color: var(--orange-press);
  }

  .start__support {
    margin: 34px 0 0;
    font-size: clamp(19px, 1.5vw, 28px);
    line-height: 1.34;
    max-width: 52ch;
  }

  .start__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .start__grid > * {
    min-width: 0;
  }

  .start__sidebar {
    display: grid;
    gap: 24px;
    position: sticky;
    top: 108px;
  }

  .start__panel {
    background: var(--ink);
    color: var(--bone);
    padding: 26px 22px;
  }

  .start__panel-title {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* On the ink panel: --steel is 3.28:1 and fails, --steel-2 is 5.68:1. */
    color: var(--steel-2);
  }

  .start__panel-title--light {
    color: var(--steel);
  }

  .start__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .start__steps li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 16.5px;
    line-height: 1.45;
  }

  .start__step-index {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--signal-orange);
  }

  .start__routes,
  .start__partner {
    background: var(--bone-3);
    border: 1.5px solid var(--ink);
    padding: 22px 20px;
  }

  .start__routes-body,
  .start__partner-body {
    margin: 0 0 16px;
    font-size: 16.5px;
    line-height: 1.45;
  }

  .start__route-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .start__route-list a {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: var(--weight-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--rule);
  }

  .start__route-list li:last-child a {
    border-bottom: 0;
  }

  @media (max-width: 900px) {
    .start__grid {
      grid-template-columns: 1fr;
    }

    .start__sidebar {
      position: static;
    }
  }
</style>
