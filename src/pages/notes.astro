---
/* /notes — kept as a route, published as an honest empty state. No backlog of unwritten titles,
   no dates, no reading times. Reachable from the footer; not featured anywhere else. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/layout/Band.astro';
import Folio from '../components/ui/Folio.astro';
import CTABand from '../components/patterns/CTABand.astro';
import { hrefFor, inquiryHref } from '../copy/routes';
import { CTA, EMPTY_STATE, HERO } from '../copy/pages/notes';
---

<BaseLayout route="notes">
  <Band ground="bone" variant="hero">
    <Folio text={HERO.folio} />
    <h1 class="notes-hero__heading">{HERO.heading}</h1>
    <p class="notes-hero__lead">{HERO.lead}</p>
  </Band>

  <Band ground="bone-2" labelledBy="notes-empty-heading">
    <div class="notes-empty">
      <span class="notes-empty__label">{EMPTY_STATE.label}</span>
      <h2 class="notes-empty__heading" id="notes-empty-heading">{EMPTY_STATE.heading}</h2>
      <p class="notes-empty__body">{EMPTY_STATE.body}</p>
    </div>
  </Band>

  <CTABand
    folio={CTA.folio}
    heading={CTA.heading}
    support={CTA.support}
    primary={{ label: CTA.primaryLabel, href: inquiryHref('workspace-pilot') }}
    secondary={{ label: CTA.secondaryLabel, href: hrefFor('workspace') }}
  />
</BaseLayout>

<style>
  .notes-hero__heading {
    font-weight: var(--weight-display-max);
    font-size: clamp(46px, 6.6vw, 118px);
    line-height: 0.85;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .notes-hero__lead {
    margin: 32px 0 0;
    font-size: clamp(19px, 1.4vw, 26px);
    line-height: 1.36;
    max-width: 50ch;
  }

  .notes-empty {
    background: var(--bone-3);
    border: 1.5px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    padding: clamp(24px, 3vw, 40px);
    max-width: 64ch;
  }

  .notes-empty__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: var(--weight-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: 16px;
  }

  .notes-empty__heading {
    font-weight: 900;
    font-size: clamp(28px, 3vw, 48px);
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  .notes-empty__body {
    margin: 20px 0 0;
    font-size: 17px;
    line-height: 1.52;
  }
</style>
