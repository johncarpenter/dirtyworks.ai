---
/* /about — the about-and-contact page.

   This is the address a visitor guesses when they want to reach the company, so it carries both
   halves: who Dirtyworks.ai is, and every way in. The contact register sits directly under the
   hero rather than at the foot of the page, and the route is in the header navigation under
   "About & contact" — the previous build reached the same information only through the footer
   address or /start.

   Founder name, biography, credentials and photograph remain outstanding sponsor inputs, tracked
   as FOUNDER_PROFILE in src/copy/placeholders.ts. The page publishes without them: it describes
   the company and names no person, so nothing here is invented, and the OPEN GAP annotation panel
   the prototype drew is not shipped. When the founder record lands, delete that registry entry and
   add the band to Company.astro. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/layout/Band.astro';
import Folio from '../components/ui/Folio.astro';
import CTABand from '../components/patterns/CTABand.astro';
import Contact from '../components/sections/about/Contact.astro';
import Company from '../components/sections/about/Company.astro';
import Beliefs from '../components/sections/about/Beliefs.astro';
import { hrefFor } from '../copy/routes';
import { CTA, HERO } from '../copy/pages/about';
---

<BaseLayout route="about">
  <Band ground="bone" variant="hero">
    <Folio text={HERO.folio} />
    <h1 class="about-hero__heading">
      {HERO.lineOne}<br /><span class="about-hero__line-two"
        >{HERO.lineTwoBefore}<span class="about-hero__emphasis">{HERO.lineTwoEmphasis}</span>{
          HERO.lineTwoAfter
        }</span
      >
    </h1>
    <p class="about-hero__support">{HERO.support}</p>
  </Band>

  <Contact />

  <Company />

  <Beliefs />

  <CTABand
    folio={CTA.folio}
    heading={CTA.heading}
    support={CTA.support}
    primary={{ label: CTA.primaryLabel, href: hrefFor('start') }}
    secondary={{ label: CTA.secondaryLabel, href: hrefFor('method') }}
  />
</BaseLayout>

<style>
  .about-hero__heading {
    font-weight: var(--weight-display-max);
    font-size: clamp(46px, 6.8vw, 122px);
    line-height: 0.84;
    letter-spacing: -0.035em;
  }

  .about-hero__line-two {
    display: inline-block;
    margin-left: -0.05em;
  }

  .about-hero__emphasis {
    color: var(--orange-press);
  }

  .about-hero__support {
    margin: 34px 0 0;
    font-size: clamp(18px, 1.4vw, 24px);
    line-height: 1.42;
    max-width: 48ch;
  }
</style>
