---
/* /services — how an engagement starts, what the managed service covers, how it runs, and where
   the boundary is. Section order is the prototype's with the two entry models added after the
   hero: hero, models, scope register, engagement path, responsibility boundary, conversion. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Folio from '../components/ui/Folio.astro';
import Button from '../components/ui/Button.astro';
import PhotoHero from '../components/patterns/PhotoHero.astro';
import CTABand from '../components/patterns/CTABand.astro';
import EngagementModels from '../components/sections/services/EngagementModels.astro';
import ScopeRegister from '../components/sections/services/ScopeRegister.astro';
import EngagementPath from '../components/sections/services/EngagementPath.astro';
import ResponsibilityBoundary from '../components/sections/services/ResponsibilityBoundary.astro';
import { SERVICES_HERO, SERVICES_CTA } from '../copy/pages/services';
import { TRAINING_ONBOARDING } from '../copy/photography';
import trainingOnboarding from '../assets/photography/training-onboarding-v1.png';

const { folio, heading, lead, action } = SERVICES_HERO;
---

<BaseLayout route="services">
  {/* Stacked, not overlaid. The direction's note on this photograph is explicit — "no significant
      empty area for headline copy; use a nearby caption or proof label" — and it is the truth of
      the picture: a dense working table with people across the whole frame. A capsule laid on it
      covers a face rather than negative space, so the copy sits in its own bone panel above. */}
  <PhotoHero
    image={trainingOnboarding}
    alt={TRAINING_ONBOARDING.alt}
    focus={TRAINING_ONBOARDING.focus}
    capsuleLayout="stack"
    labelledBy="services-hero-heading"
  >
    <div class="hero__lede">
      <Folio text={folio} />
      <h1 class="hero__heading" id="services-hero-heading">
        {heading.first}<br /><span class="hero__pull"
          >{heading.secondPrefix}<span class="hero__emphasis">{heading.emphasis}</span
          >{heading.secondSuffix}</span
        >
      </h1>
      <div class="hero__foot">
        <p class="hero__lead">{lead}</p>
        <div><Button href={action.href} size="lg">{action.label}</Button></div>
      </div>
    </div>
  </PhotoHero>

  <EngagementModels />
  <ScopeRegister />
  <EngagementPath />
  <ResponsibilityBoundary />

  <CTABand
    folio={SERVICES_CTA.folio}
    heading={SERVICES_CTA.heading}
    support={SERVICES_CTA.support}
    primary={SERVICES_CTA.primary}
    secondary={SERVICES_CTA.secondary}
  />
</BaseLayout>

<style>
  /* clamp(38px,4.4vw,76px) is the shared capsule-hero scale — the same on /, /services, /trust and
     /msps, so the four openings read as one system. Roughly half the old display size, which is
     the trade for putting the copy in a capsule (see PhotoHero).

     The 4.4vw step is not free choice: tests/e2e/fidelity.spec.ts holds heroes to at least 60px at
     its 1440px desktop viewport, and that guard exists because two pages once shipped at 34px from
     a silent scoped-CSS failure. 4vw lands at 57.6px and trips it. Do not lower this. */
  .hero__heading {
    font-weight: 900;
    font-size: clamp(38px, 4.4vw, 76px);
    line-height: 0.84;
    letter-spacing: -0.035em;
  }

  /* The second line hangs left of the margin — the page's one deliberate grid violation. */
  .hero__pull {
    display: inline-block;
    margin-left: -0.05em;
  }

  .hero__emphasis {
    color: var(--orange-press);
  }

  /* One column inside the capsule: a 1.3fr/1fr split of 30em leaves the action too narrow for
     its label. */
  .hero__foot {
    display: grid;
    gap: clamp(20px, 2.4vw, 32px);
    justify-items: start;
    margin-top: clamp(18px, 2vw, 28px);
  }

  .hero__foot > * {
    min-width: 0;
  }

  .hero__lead {
    margin: 0;
    font-size: clamp(16px, 1.15vw, 21px);
    line-height: 1.4;
    max-width: 46ch;
  }
</style>
