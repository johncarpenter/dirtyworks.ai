---
/* Home. Eight sections, in the order the workspace-pilot refresh brief specifies: the offer, what
   a team can do, the freedom-and-management distinction, what the pilot includes, trust and
   technology, the existing-AI route, the MSP route, and one conversion. Every one is a Band.

   The previous twelve-section argument — the unmanaged stack, the operating register, the vendor
   menu, the access-versus-operation comparison, the knowledge sequence, the manifesto — is gone
   from this page on purpose. The brief asked for fewer dense rows, generous reading space, concrete
   work examples, and one dominant action per section. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PilotHero from '../components/sections/pilot/PilotHero.astro';
import TeamCanDo from '../components/sections/home/TeamCanDo.astro';
import Differentiator from '../components/sections/home/Differentiator.astro';
import PilotIncludes from '../components/sections/home/PilotIncludes.astro';
import TrustTechnology from '../components/sections/home/TrustTechnology.astro';
import ExistingAi from '../components/sections/home/ExistingAi.astro';
import MspRoute from '../components/sections/home/MspRoute.astro';
import Conversion from '../components/sections/home/Conversion.astro';
---

<BaseLayout route="home">
  <PilotHero />
  <TeamCanDo />
  <Differentiator />
  <PilotIncludes />
  <TrustTechnology />
  <ExistingAi />
  <MspRoute />
  <Conversion />
</BaseLayout>
