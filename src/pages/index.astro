import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/home/Hero.astro';
import Problem from '../components/sections/home/Problem.astro';
import WhatWeOperate from '../components/sections/home/WhatWeOperate.astro';
import Catalogue from '../components/sections/home/Catalogue.astro';
import Comparison from '../components/sections/home/Comparison.astro';
import Knowledge from '../components/sections/home/Knowledge.astro';
import Method from '../components/sections/home/Method.astro';
import Trust from '../components/sections/home/Trust.astro';
import Fit from '../components/sections/home/Fit.astro';
import MspLane from '../components/sections/home/MspLane.astro';
import Manifesto from '../components/sections/home/Manifesto.astro';
import Conversion from '../components/sections/home/Conversion.astro';
---

<BaseLayout route="home">
  <Hero />
  <Problem />
  <WhatWeOperate />
  <Catalogue />
  <Comparison />
